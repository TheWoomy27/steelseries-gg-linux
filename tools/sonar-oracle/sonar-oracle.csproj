<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build with -p:SonarDir=<installer>/apps/sonar (Sonar's assemblies). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json"><HintPath>$(SonarDir)/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
