#!/bin/sh
# Launches the SteelSeries GG client on Linux. The client is the Electron app
# imported from your installer by gg-setup; ggd is started on demand.
set -e

data="${GG_LINUX_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/steelseries-gg}"
app="$data/client/app"

if [ ! -f "$app/package.json" ]; then
    echo "SteelSeries GG has not been imported yet. Run: gg-setup /path/to/SteelSeriesGG<version>Setup.exe" >&2
    exit 1
fi

electron="${GG_LINUX_ELECTRON:-}"
if [ -z "$electron" ]; then
    # The Windows client ships Electron 31; newer releases keep the
    # BrowserView/WebContentsView APIs it uses.
    for e in electron37 electron39 electron38 electron36 electron35 electron34 electron33 electron32 electron31 electron; do
        if command -v "$e" >/dev/null 2>&1; then electron="$e"; break; fi
    done
fi
if [ -z "$electron" ]; then
    echo "No Electron runtime found. Install electron37 (or set GG_LINUX_ELECTRON)." >&2
    exit 1
fi

# Machines with GPUs from more than one driver (an Intel iGPU beside an
# NVIDIA card, say): Electron 37's Chromium allocates window buffers on the
# first render node and draws through whichever EGL driver libglvnd tries
# first. When those are not the GPU driving the monitors, its GPU process
# crashes and GG falls back to software rendering, so point both at the GPU
# the displays are on (newer Chromium does this itself). The EGL driver has
# to be chosen in the environment, before Electron starts.

# display_gpu prints the sysfs device of the GPU with connected displays,
# if there is exactly one.
display_gpu() {
    gpu=""
    for status in /sys/class/drm/card*-*/status; do
        [ "$(cat "$status" 2>/dev/null)" = connected ] || continue
        card=${status%/status}
        card=${card##*/}
        dev=$(readlink -f "/sys/class/drm/${card%%-*}/device") || continue
        if [ -n "$gpu" ] && [ "$gpu" != "$dev" ]; then
            return 1
        fi
        gpu=$dev
    done
    [ -n "$gpu" ] && echo "$gpu"
}

gpu_args=""
drivers=$(for n in /sys/class/drm/renderD*; do readlink -f "$n/device/driver"; done 2>/dev/null | sort -u | wc -l)
if [ "$drivers" -gt 1 ] && [ -z "${__EGL_VENDOR_LIBRARY_FILENAMES:-}" ] && gpu=$(display_gpu); then
    node=$(ls "$gpu/drm" 2>/dev/null | grep '^renderD' | head -n1)
    case $(basename "$(readlink -f "$gpu/driver")") in
        nvidia) egl=libEGL_nvidia ;;
        *) egl=libEGL_mesa ;;
    esac
    for f in /etc/glvnd/egl_vendor.d/*.json /usr/share/glvnd/egl_vendor.d/*.json; do
        if [ -f "$f" ] && grep -q "$egl" "$f"; then
            export __EGL_VENDOR_LIBRARY_FILENAMES="$f"
            break
        fi
    done
    [ -n "$node" ] && gpu_args="--render-node-override=/dev/dri/$node"
fi

# $gpu_args is unquoted so that it vanishes when empty.
# shellcheck disable=SC2086
exec "$electron" "$app" $gpu_args "$@"
